    // Compact non-widget items row-major in landscape to avoid big gaps while preserving portrait positions
    private List<AppItem> compactItemsForLandscape(List<AppItem> items) {
        if (items == null) return new ArrayList<>();
        // Temporary occupancy for this orientation only
        AppItem[][] temp = new AppItem[ROWS][COLS];

        // Separate widgets and regular items
        List<AppItem> widgets = new ArrayList<>();
        List<AppItem> others = new ArrayList<>();
        for (AppItem it : items) {
            if (it.getType() == AppItem.Type.WIDGET || it.getRowSpan() > 1 || it.getColSpan() > 1)
                widgets.add(it);
            else others.add(it);
        }

        // Place widgets at their stored positions if they fit, otherwise find space
        // CRITICAL: Do NOT modify the database - these are in-memory adjustments only
        for (AppItem w : widgets) {
            int r = Math.max(0, Math.min(w.getRow(), ROWS - Math.max(1, w.getRowSpan())));
            int c = Math.max(0, Math.min(w.getCol(), COLS - Math.max(1, w.getColSpan())));
            if (!isRegionFree(temp, r, c, w.getRowSpan(), w.getColSpan())) {
                int[] pos = findFirstFreeRegion(temp, w.getRowSpan(), w.getColSpan());
                if (pos != null) {
                    // Set position in-memory only for this render pass (no DB update)
                    w.setPosition(pos[0], pos[1]);
                    r = pos[0];
                    c = pos[1];
                } else {
                    // Widget doesn't fit in landscape - it should remain on its original page
                    // Skip rendering but DO NOT remove from database or change page
                    Log.w(TAG, "Widget '" + w.getName() + "' doesn't fit in landscape on page " + pageIndex + ", keeping on original page");
                    continue;
                }
            }
            for (int rr = r; rr < r + w.getRowSpan(); rr++)
                for (int cc = c; cc < c + w.getColSpan(); cc++) temp[rr][cc] = w;
        }

        // Pack apps and special items maintaining their relative order
        others.sort((a, b) -> {
            int pa = typePriority(a);
            int pb = typePriority(b);
            if (pa != pb) return Integer.compare(pa, pb);
            if (a.getRow() != b.getRow()) return Integer.compare(a.getRow(), b.getRow());
            return Integer.compare(a.getCol(), b.getCol());
        });

        for (AppItem it : others) {
            int[] pos = findFirstFreeRegion(temp, 1, 1);
            if (pos == null) {
                // No space in landscape view - keep item on its original page
                // DO NOT change page assignment or shrink the item
                Log.w(TAG, "Item '" + it.getName() + "' doesn't fit in landscape on page " + pageIndex + ", keeping on original page");
                continue;
            }
            int nr = pos[0], nc = pos[1];
            // Update in-memory only (no DB update for orientation-specific layout)
            it.setPosition(nr, nc);
            it.setRowSpan(1);
            it.setColSpan(1);
            temp[nr][nc] = it;
        }

        return items;
    }

